import os
from telegram import Update, InlineKeyboardButton, InlineKeyboardMarkup
from telegram.ext import Application, CommandHandler, CallbackQueryHandler, ContextTypes

TOKEN = os.getenv(8759846705:AAENAspv9Y-kp7fZkpIn67VTCedf75GVt2Y)
TOTAL_MINED = 0
TOTAL_BURNED = 0
users = {}

async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user_id = update.effective_user.id
    if user_id not in users:
        users[user_id] = 0
    keyboard = [[InlineKeyboardButton("⛏️ MINE $JERRY", callback_data="mine")]]
    await update.message.reply_text(f"Welcome to JERRY MINE 💎\nYour Balance: {users[user_id]} $JERRY\n\nNo burn now. 50% burn at launch!", reply_markup=InlineKeyboardMarkup(keyboard))

async def mine_btn(update: Update, context: ContextTypes.DEFAULT_TYPE):
    global TOTAL_MINED
    query = update.callback_query
    user_id = query.from_user.id
    users[user_id] = users.get(user_id, 0) + 100
    TOTAL_MINED += 100
    await query.answer()
    keyboard = [[InlineKeyboardButton("⛏️ MINE AGAIN", callback_data="mine")]]
    await query.edit_message_text(f"You mined 100 $JERRY!\nBalance: {users[user_id]}\nTotal Mined: {TOTAL_MINED}", reply_markup=InlineKeyboardMarkup(keyboard))

async def burn50(update: Update, context: ContextTypes.DEFAULT_TYPE):
    # ONLY YOU FIT USE AM - Put your Telegram ID here
    if update.effective_user.id != 123456789: # Change to your ID
        return
    global TOTAL_MINED, TOTAL_BURNED
    burn = TOTAL_MINED // 2
    TOTAL_BURNED += burn
    TOTAL_MINED -= burn
    await update.message.reply_text(f"🔥 BURNED 50%!\n🔥 {burn} $JERRY sent to dead wallet!\nNew Supply: {TOTAL_MINED}")

app = Application.builder().token(TOKEN).build()
app.add_handler(CommandHandler("start", start))
app.add_handler(CommandHandler("burn50", burn50))
app.add_handler(CallbackQueryHandler(mine_btn))
app.run_polling()
